# Prefer pnpm bootstrap to generate unique local credentials. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-owner-password
POSTGRES_APP_PASSWORD=replace-with-random-app-password
MIGRATION_DATABASE_URL=postgres://chainvanta_owner:replace-with-random-owner-password@127.0.0.1:5432/chainvanta
DATABASE_URL=postgres://chainvanta_app:replace-with-random-app-password@127.0.0.1:5432/chainvanta
TENANT_API_KEYS='[{"tenantId":"replace-with-uuid","key":"replace-with-at-least-32-random-characters"}]'
CHAINS='[{"chainId":1,"name":"Ethereum","rpcUrl":"https://your-approved-rpc.example"}]'
PORT=4000
API_HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:4000
# CLI only: provision an existing tenant key here, never a wallet private key.
# CHAINVANTA_API_KEY=
REDIS_URL=redis://127.0.0.1:6379
# Optional API-only OIDC; console interactive OIDC is not implemented.
# OIDC_CONFIG='{"issuer":"https://identity.example","audience":"chainvanta","jwksUrl":"https://identity.example/jwks","memberships":[{"subject":"approved-subject","tenantId":"replace-with-uuid","role":"viewer"}]}'
# Tenant keys accept role: viewer, analyst (default), or admin.
# Add "archive":true only for providers that serve historical state; it enables discoverTransaction.
# For deterministic local fixture collection, use CHAINS with rpcUrl http://127.0.0.1:8545 and demonstration:true.

# Durable CPM worker, shared across all worker replicas for a tenant.
# CPM_TENANT_CONCURRENCY=2
# CPM_RPC_PER_MINUTE=120
# Production API and worker must set NODE_ENV=production; demonstration chains are rejected.
# Provision authenticated/TLS PostgreSQL and Redis separately; local Compose is development only.
