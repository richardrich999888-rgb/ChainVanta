{
  "name": "chainvanta",
  "version": "0.1.0",
  "private": true,
  "description": "SYNTRIASS cryptographic inventory and evidence platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "start:worker": "node --env-file=.env dist/workers/assessment-worker/main.js",
    "demo:cpm": "tsx --tsconfig packages/config/tsconfig.json scripts/development/cpm-demo.ts",
    "worker:cpm": "tsx --tsconfig packages/config/tsconfig.json --env-file=.env workers/assessment-worker/main.ts",
    "dev": "concurrently -k -n api,console 'pnpm dev:api' 'pnpm dev:web'",
    "dev:api": "tsx watch --tsconfig packages/config/tsconfig.json --env-file=.env services/api-gateway/src/main.ts",
    "dev:web": "pnpm --filter @chainvanta/web-console dev",
    "build": "tsc -p packages/config/tsconfig.build.json && pnpm --filter @chainvanta/web-console build",
    "start:api": "node --env-file=.env dist/services/api-gateway/src/main.js",
    "typecheck": "tsc --noEmit -p packages/config/tsconfig.json && pnpm --filter @chainvanta/web-console typecheck",
    "lint": "eslint .",
    "test": "vitest run --config scripts/testing/vitest.config.ts",
    "test:integration": "vitest run --config scripts/testing/vitest.config.ts tests/integration",
    "test:e2e": "playwright test --config scripts/testing/playwright.config.ts",
    "db:migrate": "tsx --tsconfig packages/config/tsconfig.json --env-file=.env scripts/database/migrate.ts",
    "bootstrap": "node scripts/bootstrap/local.mjs",
    "cli": "tsx --tsconfig packages/config/tsconfig.json --env-file=.env cli/chainvanta/index.ts",
    "format": "prettier --ignore-path scripts/development/prettierignore --write .",
    "format:check": "prettier --ignore-path scripts/development/prettierignore --check .",
    "api:generate": "tsx --tsconfig packages/config/tsconfig.json scripts/development/generate-api.ts && openapi-typescript packages/api-contracts/openapi.yaml -o packages/api-contracts/generated.ts && prettier --write packages/api-contracts/openapi.yaml packages/api-contracts/generated.ts",
    "dev:fixture": "tsx --tsconfig packages/config/tsconfig.json scripts/development/fixture-rpc.ts",
    "test:native": "tsx --tsconfig packages/config/tsconfig.json --env-file=.env scripts/testing/native.ts",
    "db:seed": "tsx --tsconfig packages/config/tsconfig.json --env-file=.env scripts/database/seed.ts",
    "test:e2e:native": "tsx --tsconfig packages/config/tsconfig.json --env-file=.env scripts/testing/native.ts --e2e",
    "test:go": "cd workers/blockchain-indexer && go test ./...",
    "sbom": "node scripts/release/sbom.mjs",
    "check:structure": "node scripts/testing/repository-structure.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
